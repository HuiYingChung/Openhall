# Copy this file to `.env` and fill in your real values.
# `.env` is gitignored — NEVER commit real keys.
#
# Get these from https://cloud.ibm.com → your watsonx.ai project:
#   - API key:    IAM API keys page
#   - Project ID: watsonx.ai project → Manage → General

WATSONX_API_KEY=paste-your-api-key-here
WATSONX_PROJECT_ID=paste-your-project-id-here

# Optional — change only if your instance is not in the Dallas region
# WATSONX_URL=https://us-south.ml.cloud.ibm.com

# ---------------------------------------------------------------------------
# Dev-only: pre-fill browser settings automatically (Vite only, never exposed
# in production builds). Copy the same values from above.
# VITE_WATSONX_API_KEY=paste-your-api-key-here
# VITE_WATSONX_PROJECT_ID=paste-your-project-id-here
# VITE_TOKEN_WORKER_URL=http://localhost:8787
