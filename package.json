{
  "name": "openhall",
  "version": "0.1.0",
  "description": "AI-generated 3D galleries that artists actually own.",
  "type": "module",
  "scripts": {
    "dev": "npm run build:viewer && vite",
    "worker:dev": "wrangler dev worker/token-exchange.ts --port 8787",
    "build:viewer": "tsc && vite build --config vite.viewer.config.ts && node scripts/copy-viewer.mjs",
    "build": "npm run build:viewer && tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "three": "^0.165.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.5.0",
    "@types/jsdom": "^28.0.3",
    "@types/three": "^0.165.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.5.0",
    "eslint-config-prettier": "^9.1.0",
    "jsdom": "^29.1.1",
    "jszip": "^3.10.1",
    "prettier": "^3.3.2",
    "typescript": "^5.5.2",
    "vite": "^5.3.1",
    "vitest": "^1.6.0",
    "wrangler": "^4.107.0"
  }
}
